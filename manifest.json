{
  "manifest_version": 3,
  "name": "Chrome Script Executor",
  "version": "1.0.0",
  "description": "Capture user scripts and JSON data from one website and run them on another.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/capture.js",
        "content/drawer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/drawer.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
